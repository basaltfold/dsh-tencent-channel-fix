{
  "name": "dsh-tencent-channel-fix",
  "version": "1.2.0",
  "description": "Repairs dsh-our-free-model at boot: the CodeArts (Huawei Cloud) signed-transport lifetime that broke after a plugin restart, the CodeArts queue-retry budget that turned a full 3-session account into 30 minutes of silence, a dangling injection left by an earlier revision, and the buddy/workbuddy 400 (code 11128) attribution User-Agent · 修复 OFM 的 CodeArts 签名传输生命周期与排队重试预算、清掉旧版本残留的注入，并继续修 buddy/workbuddy 的 400 code=11128",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./patcher": "./lib/patcher.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "buddy",
    "workbuddy",
    "codebuddy",
    "tencent",
    "11128",
    "dsh-our-free-model",
    "codearts",
    "huaweicloud",
    "channel-fix",
    "ttft",
    "latency",
    "queue",
    "concurrency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltfold/dsh-tencent-channel-fix.git"
  },
  "homepage": "https://github.com/basaltfold/dsh-tencent-channel-fix#readme",
  "bugs": {
    "url": "https://github.com/basaltfold/dsh-tencent-channel-fix/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/basaltfold/dsh-tencent-channel-fix/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/basaltfold/dsh-tencent-channel-fix/archive/refs/heads/master.zip",
      "git": "https://github.com/basaltfold/dsh-tencent-channel-fix.git"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/patcher.js && node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
